# Docker & Environment configuration for Yemen Community App

# Database (SQLite for local, PostgreSQL for production)
# In production, use Postgres URL (internal) from Coolify
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="super-secret-key-change-this-in-production-1234567890"
ADMIN_EMAIL="admin@yemeni-community.com"
# Bcrypt hash for your admin password
ADMIN_PASSWORD_HASH="$2a$12$REPLACE_WITH_YOUR_BCRYPT_HASH"

# Cloudflare R2
R2_ENDPOINT="https://[account_id].r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="yemeni-images"
R2_PUBLIC_URL="https://images.yourdomain.com"

# n8n
N8N_WEBHOOK_URL="https://admin.yemcoeg.online/webhook"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
